# Android/runtime text must stay UTF-8 without BOM and LF-only on every host.
.gitattributes text eol=lf
.gitignore text eol=lf
*.sh text eol=lf
*.tsv text eol=lf
*.prop text eol=lf
*.json text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.py text eol=lf
*.xml text eol=lf
META-INF/com/google/android/update-binary text eol=lf
META-INF/com/google/android/updater-script text eol=lf

# Binary payloads and release artifacts must never be line-normalized.
*.binarypb binary
*.mbn binary
*.img binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.woff2 binary
*.zip binary
